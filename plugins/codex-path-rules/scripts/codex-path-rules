#!/usr/bin/env bash
# Claude Code の rule から、Codex が常時読む本文を収集する。

set -euo pipefail

usage() {
	echo "usage: codex-path-rules always [cwd]" >&2
}

if [ "${1:-}" != "always" ] || [ "$#" -gt 2 ]; then
	usage
	exit 2
fi

for command_name in awk cat dirname find git sort; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		echo "codex-path-rules: 必要なコマンドが見つからない: $command_name" >&2
		exit 2
	fi
done

cwd="${2:-$PWD}"
if ! cwd="$(cd "$cwd" 2>/dev/null && pwd -P)"; then
	echo "codex-path-rules: 作業ディレクトリを読めない: ${2:-$PWD}" >&2
	exit 2
fi

rule_dirs=()
if [ -d "$HOME/.claude/rules" ]; then
	rule_dirs+=("$HOME/.claude/rules")
fi

if repo_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"; then
	repo_root="$(cd "$repo_root" && pwd -P)"
	project_rule_dirs=()
	cursor="$cwd"
	while :; do
		if [ -d "$cursor/.claude/rules" ]; then
			project_rule_dirs=("$cursor/.claude/rules" "${project_rule_dirs[@]}")
		fi
		[ "$cursor" = "$repo_root" ] && break
		parent="$(dirname "$cursor")"
		[ "$parent" = "$cursor" ] && break
		cursor="$parent"
	done
	rule_dirs+=("${project_rule_dirs[@]}")
fi

for rule_dir in "${rule_dirs[@]}"; do
	while IFS= read -r rule_file; do
		if awk '
			NR == 1 && $0 == "---" { in_frontmatter = 1; next }
			in_frontmatter && $0 == "---" { exit }
			in_frontmatter && $0 ~ /^[[:space:]]*paths[[:space:]]*:/ { found = 1 }
			END { exit(found ? 0 : 1) }
		' "$rule_file"; then
			continue
		fi
		printf '\n<!-- source: %s -->\n' "$rule_file"
		cat "$rule_file"
	done < <(find -L "$rule_dir" -type f -name '*.md' -print | LC_ALL=C sort)
done
