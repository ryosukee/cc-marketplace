#!/bin/bash
# テスト用の偽の security。`security find-generic-password -s plane-kanban<...> -w` にだけ答え、
# FAKE_KEYCHAIN_DIR/<service> の中身を返す。無ければ exit 44（本物の security と同じ errSecItemNotFound）
# FAKE_KEYCHAIN_DIR が未設定なら、git の作業ツリーの最上位（無ければ cwd）の .fake-keychain を使う
#
# plane-kanban 以外の service と、find-generic-password 以外のサブコマンドは本物の security に渡す。
# eval では PATH の先頭にこのディレクトリを置くので、渡さないと claude plugin eval 自身が
# Keychain のログイン情報を読めなくなる

set -euo pipefail

real_security=/usr/bin/security
dir="${FAKE_KEYCHAIN_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.fake-keychain}"

[ "${1:-}" = "find-generic-password" ] || exec "$real_security" "$@"

service=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-s" ]; then service="$arg"; fi
  prev="$arg"
done

case "$service" in
  plane-kanban*) ;;
  *) exec "$real_security" "$@" ;;
esac

if [ -f "$dir/$service" ]; then
  cat "$dir/$service"
else
  echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2
  exit 44
fi
