#!/bin/bash
# テスト用の偽の curl。lib/plane.sh が呼ぶ形（-sS -X METHOD URL -H ... -D 出力 -o 出力 -w '%{http_code}' [--data BODY]）
# だけを受け付け、Plane の API の応答を FAKE_CURL_STATE 配下の JSON で真似る。ネットワークは使わない
#
# 状態: FAKE_CURL_STATE/projects.json, states.json, labels.json, items.json, seq（連番）, requests.log（呼び出しの記録）
# states.json は project を作ったときに入る既定の 5 つで始まる（project ごとには分けない）
# 429 の再現: FAKE_CURL_STATE/429-once があれば 1 回だけ 429 を返してそのファイルを消す
#
# label の形は実際の API に合わせる。work item の一覧・作成・PATCH の応答は label の id の配列、
# work item 1 件の GET だけが label のオブジェクトの配列を返す（Plane Cloud で確かめた）。
# PATCH は label に id 以外が来たら 400 を返す

set -euo pipefail

state="${FAKE_CURL_STATE:?FAKE_CURL_STATE が未設定}"
mkdir -p "$state"
[ -f "$state/projects.json" ] || echo '[]' > "$state/projects.json"
[ -f "$state/states.json" ] || cat > "$state/states.json" <<'JSON'
[
  {"id":"s1","name":"Backlog","group":"backlog","sequence":15000},
  {"id":"s2","name":"Todo","group":"unstarted","sequence":25000},
  {"id":"s3","name":"In Progress","group":"started","sequence":35000},
  {"id":"s4","name":"Done","group":"completed","sequence":45000},
  {"id":"s5","name":"Cancelled","group":"cancelled","sequence":55000}
]
JSON
[ -f "$state/labels.json" ] || echo '[]' > "$state/labels.json"
[ -f "$state/items.json" ] || echo '[]' > "$state/items.json"
[ -f "$state/seq" ] || echo 0 > "$state/seq"

method="GET"
url=""
hdr=""
out=""
body=""
while [ $# -gt 0 ]; do
  case "$1" in
    -sS|-s|-S) shift ;;
    -X) method="$2"; shift 2 ;;
    -H) shift 2 ;;
    -D) hdr="$2"; shift 2 ;;
    -o) out="$2"; shift 2 ;;
    -w) shift 2 ;;
    --data) body="$2"; shift 2 ;;
    http*) url="$1"; shift ;;
    *) echo "fake curl: 不明な引数 $1" >&2; exit 3 ;;
  esac
done

path="${url#*/workspaces/}"
path="/${path#*/}"
query=""
case "$path" in *\?*) query="${path#*\?}"; path="${path%%\?*}" ;; esac
printf '%s %s %s\n' "$method" "$path" "$body" >> "$state/requests.log"
workspace="${url#*/workspaces/}"
printf '%s\n' "${workspace%%/*}" >> "$state/workspaces.log"

# 種類ごとの連番。引数: $1 = 種類（project / label / item）
next_seq() {
  local f="$state/seq-$1" n
  [ -f "$f" ] || echo 0 > "$f"
  n=$(( $(cat "$f") + 1 ))
  echo "$n" > "$f"
  echo "$n"
}

respond() {
  local code="$1" json="$2"
  printf 'HTTP/1.1 %s\r\nContent-Type: application/json\r\n' "$code" > "$hdr"
  if [ "$code" = "429" ]; then
    printf 'X-RateLimit-Remaining: 0\r\nX-RateLimit-Reset: %s\r\n' "$(( $(date +%s) + 1 ))" >> "$hdr"
  fi
  printf '\r\n' >> "$hdr"
  printf '%s' "$json" > "$out"
  printf '%s' "$code"
}

paginate() {
  jq -c '{results: ., next_cursor: null, next_page_results: false, count: length}'
}

# work item の label の id を、labels.json の label のオブジェクトに展開する。stdin = work item の JSON
expand_labels() {
  jq -c --slurpfile lab "$state/labels.json" \
    '.labels |= map(. as $l | (($lab[0] | map(select(.id == $l)) | first) // {id: $l}))'
}

if [ -f "$state/429-once" ]; then
  rm -f "$state/429-once"
  respond 429 '{"error":"throttled"}'
  exit 0
fi

case "$method $path" in
  "GET /projects/")
    respond 200 "$(paginate < "$state/projects.json")" ;;
  "POST /projects/")
    n=$(next_seq project)
    new=$(jq -c --arg id "p$n" '. + {id: $id}' <<<"$body")
    jq -c --argjson e "$new" '. + [$e]' "$state/projects.json" > "$state/tmp" && mv "$state/tmp" "$state/projects.json"
    respond 201 "$new" ;;
  "GET /projects/"*"/states/")
    respond 200 "$(paginate < "$state/states.json")" ;;
  "POST /projects/"*"/states/")
    # 実際の API と同じく、同名の state があれば 409 で既存の id を返し、sequence は既存の最大値 + 15000 にする
    name=$(jq -r '.name' <<<"$body")
    dup=$(jq -r --arg n "$name" '[.[] | select(.name == $n)] | first | .id // empty' "$state/states.json")
    if [ -n "$dup" ]; then
      respond 409 "$(jq -cn --arg id "$dup" '{error: "State with the same name already exists in the project", id: $id}')"
      exit 0
    fi
    n=$(next_seq state)
    new=$(jq -c --arg id "sn$n" --slurpfile st "$state/states.json" \
      '{id: $id, name: .name, color: .color, group: (.group // "backlog"), sequence: (($st[0] | map(.sequence) | max) + 15000)}' <<<"$body")
    jq -c --argjson e "$new" '. + [$e]' "$state/states.json" > "$state/tmp" && mv "$state/tmp" "$state/states.json"
    respond 200 "$new" ;;
  "PATCH /projects/"*"/states/"*"/")
    id="${path%/}"; id="${id##*/}"
    jq -c --arg id "$id" --argjson b "$body" 'map(if .id == $id then . + $b else . end)' "$state/states.json" > "$state/tmp" && mv "$state/tmp" "$state/states.json"
    respond 200 "$(jq -c --arg id "$id" '[.[] | select(.id == $id)] | first' "$state/states.json")" ;;
  "GET /projects/"*"/labels/")
    respond 200 "$(paginate < "$state/labels.json")" ;;
  "POST /projects/"*"/labels/")
    n=$(next_seq label)
    new=$(jq -c --arg id "l$n" '. + {id: $id}' <<<"$body")
    jq -c --argjson e "$new" '. + [$e]' "$state/labels.json" > "$state/tmp" && mv "$state/tmp" "$state/labels.json"
    respond 201 "$new" ;;
  "GET /projects/"*"/work-items/")
    respond 200 "$(paginate < "$state/items.json")" ;;
  "POST /projects/"*"/work-items/")
    n=$(next_seq item)
    new=$(jq -c --arg id "w$n" --argjson n "$n" \
      '{id: $id, sequence_id: $n, name: .name, state: (.state // "s1"), labels: (.labels // []), parent: (.parent // null), description_html: (.description_html // "")}' <<<"$body")
    jq -c --argjson e "$new" '. + [$e]' "$state/items.json" > "$state/tmp" && mv "$state/tmp" "$state/items.json"
    respond 201 "$new" ;;
  "GET /projects/"*"/work-items/"*"/")
    id="${path%/}"; id="${id##*/}"
    item=$(jq -c --arg id "$id" '[.[] | select(.id == $id)] | first // empty' "$state/items.json")
    if [ -z "$item" ]; then respond 404 '{"detail":"not found"}'; else respond 200 "$(expand_labels <<<"$item")"; fi ;;
  "PATCH /projects/"*"/work-items/"*"/")
    id="${path%/}"; id="${id##*/}"
    if ! jq -e '(.labels // []) | all(type == "string")' <<<"$body" >/dev/null; then
      respond 400 '{"labels":{"0":["is not a valid UUID."]}}'
      exit 0
    fi
    jq -c --arg id "$id" --argjson b "$body" 'map(if .id == $id then . + $b else . end)' "$state/items.json" > "$state/tmp" && mv "$state/tmp" "$state/items.json"
    item=$(jq -c --arg id "$id" '[.[] | select(.id == $id)] | first' "$state/items.json")
    respond 200 "$item" ;;
  "GET /projects/"*"/")
    id="${path%/}"; id="${id##*/}"
    project=$(jq -c --arg id "$id" '[.[] | select(.id == $id)] | first // empty' "$state/projects.json")
    if [ -z "$project" ]; then respond 404 '{"detail":"not found"}'; else respond 200 "$project"; fi ;;
  *)
    respond 404 "{\"detail\":\"no route for $method $path\"}" ;;
esac
